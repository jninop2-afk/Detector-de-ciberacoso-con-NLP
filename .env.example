# --- Discord ---
DISCORD_BOT_TOKEN=
# Servidor del dueño del bot: allí aparecen /reentrenar, /servidores y /confiar
# (si se deja vacío se deduce de ADMIN_MOD_CHANNEL_ID)
OWNER_GUILD_ID=
# Opcional: canal de moderación del servidor original (se migra automáticamente;
# los demás servidores lo configuran con /configurar)
ADMIN_MOD_CHANNEL_ID=

# --- Bluesky ---
BLUESKY_HANDLE=tu-bot.bsky.social
# App Password (Ajustes > Privacidad y seguridad > App Passwords), NO la contraseña real
BLUESKY_APP_PASSWORD=
# Cuentas a vigilar, separadas por coma y sin @
BLUESKY_CUENTAS_VIGILADAS=
# 1 = enviar reportes reales a la moderación de Bluesky (por defecto: simulación)
BLUESKY_REPORTES_REALES=0
BLUESKY_UMBRAL_REPORTE=0.60
BLUESKY_INTERVALO=15
# Máximo de cuentas que pueden pedir vigilancia mencionando al bot con "vigilar"
BLUESKY_MAX_VIGILADAS=50

# --- Copias de seguridad (python main.py backup / automática cada 24 h) ---
BACKUP_DIR=backups
BACKUP_KEEP=14

# --- Detector (opcionales) ---
ROBERTA_ENABLED=1
CONFIDENCE_THRESHOLD=0.70
UNCERTAINTY_MARGIN=0.20
MIN_CLASS_F1=0.60
ROBERTA_WEIGHT=0.70
